  "services": {
    "get_monthly_statistics": {
      "name": "Get monthly statistics",
      "description": "Return the monthly journey statistics for one Zeekr vehicle.",
      "fields": {
        "vin": {
          "name": "Vehicle VIN",
          "description": "VIN of the vehicle."
        },
        "year_month": {
          "name": "Month",
          "description": "Month in YYYY-MM format."
        },
        "account_id": {
          "name": "Account ID",
          "description": "Zeekr account ID the statistics belong to."
        }
      }
    },
    "get_app_messages": {
      "name": "Get app messages",
      "description": "Return app upgrade messages for one Zeekr vehicle.",
      "fields": {
        "vin": {
          "name": "Vehicle VIN",
          "description": "VIN of the vehicle."
        }
      }
    },
    "remote_control": {
      "name": "Remote control (advanced)",
      "description": "Send a raw remote-control command to one vehicle. The envelope is confirmed from the app; serviceId acceptance varies per vehicle generation. Examples: serviceId RSM (sentry), ZAF (climate: AC/DF/SH.xx/RC/RW params), RCC (cabin ventilation), RDU/RDL (door unlock/lock, target param), RTU/RTL (trunk), RHL (flash & horn).",
      "fields": {
        "vin": {
          "name": "Vehicle VIN",
          "description": "VIN of the vehicle."
        },
        "service_id": {
          "name": "Service ID",
          "description": "Remote service, e.g. RSM, ZAF, RDU."
        },
        "command": {
          "name": "Command",
          "description": "Command of the service, e.g. start or stop."
        },
        "parameters": {
          "name": "Service parameters",
          "description": "List of {key, value} objects placed in setting.serviceParameters."
        },
        "duration": {
          "name": "Duration",
          "description": "Optional run time placed in setting.operationScheduling.duration."
        },
        "wait_result": {
          "name": "Wait for result",
          "description": "Wait up to 45 seconds for the car to report whether it executed the command."
        }
      }
    },
    "api_get": {
      "name": "API GET (research)",
      "description": "Administrator-only. Send a signed GET request to a path of the Zeekr vehicle API and return the raw answer. For exploring read endpoints; it cannot send commands.",
      "fields": {
        "vin": {
          "name": "Vehicle VIN",
          "description": "VIN of the vehicle."
        },
        "path": {
          "name": "Path",
          "description": "API path, starting with a slash."
        },
        "params": {
          "name": "Query parameters",
          "description": "Query string parameters as key/value pairs."
        }
      }
    }
  }
