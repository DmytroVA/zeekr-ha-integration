  "services": {
    "get_monthly_statistics": {
      "name": "获取月度统计",
      "description": "返回一辆 Zeekr 车辆的月度行程统计。",
      "fields": {
        "vin": {
          "name": "车辆 VIN",
          "description": "车辆的 VIN。"
        },
        "year_month": {
          "name": "月份",
          "description": "格式为 YYYY-MM 的月份。"
        },
        "account_id": {
          "name": "账号 ID",
          "description": "统计所属的 Zeekr 账号 ID。"
        }
      }
    },
    "get_app_messages": {
      "name": "获取应用消息",
      "description": "返回一辆 Zeekr 车辆的应用升级消息。",
      "fields": {
        "vin": {
          "name": "车辆 VIN",
          "description": "车辆的 VIN。"
        }
      }
    },
    "remote_control": {
      "name": "远程控制（高级）",
      "description": "向一辆车发送原始远程控制指令。请求格式已从应用确认；车辆接受哪些 serviceId 因车型代际而异。示例：serviceId RSM（哨兵）、ZAF（空调：AC/DF/SH.xx/RC/RW 参数）、RCC（座舱通风）、RDU/RDL（车门解锁/上锁，target 参数）、RTU/RTL（后备箱）、RHL（闪灯鸣笛）。",
      "fields": {
        "vin": {
          "name": "车辆 VIN",
          "description": "车辆的 VIN。"
        },
        "service_id": {
          "name": "服务 ID",
          "description": "远程服务，例如 RSM、ZAF、RDU。"
        },
        "command": {
          "name": "指令",
          "description": "服务的指令，例如 start 或 stop。"
        },
        "parameters": {
          "name": "服务参数",
          "description": "放入 setting.serviceParameters 的 {key, value} 对象列表。"
        },
        "duration": {
          "name": "时长",
          "description": "可选运行时间，放入 setting.operationScheduling.duration。"
        },
        "wait_result": {
          "name": "等待结果",
          "description": "最多等待 45 秒，直到车辆报告是否已执行指令。"
        }
      }
    },
    "api_get": {
      "name": "API GET（研究）",
      "description": "仅限管理员。向 Zeekr 车辆 API 的某个路径发送签名 GET 请求并返回原始响应。用于探索读取接口；无法发送指令。",
      "fields": {
        "vin": {
          "name": "车辆 VIN",
          "description": "车辆的 VIN。"
        },
        "path": {
          "name": "路径",
          "description": "以斜杠开头的 API 路径。"
        },
        "params": {
          "name": "查询参数",
          "description": "以键/值对形式的查询字符串参数。"
        }
      }
    }
  }
